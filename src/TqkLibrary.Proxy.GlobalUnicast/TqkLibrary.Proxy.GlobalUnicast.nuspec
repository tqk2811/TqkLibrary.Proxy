<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
	<!--https://docs.microsoft.com/en-us/nuget/reference/nuspec-->
	<metadata>
		<id>$id$</id>
		<version>$version$</version>
		<description>Windows-only proxy source for global unicast address assignment using native SLAAC/IPv6 address manipulation APIs.</description>
		<authors>tqk2811</authors>
		<projectUrl>https://github.com/tqk2811/TqkLibrary.Proxy</projectUrl>
		<repository type="git" url="https://github.com/tqk2811/TqkLibrary.Proxy.git"/>
		<license type="expression">MIT</license>
		<readme>docs\README.md</readme>
		<dependencies>
			<group targetFramework="net462">
				<dependency id="TqkLibrary.Proxy" version="1.0.24" />
			</group>
			<group targetFramework="net6.0-windows7.0">
				<dependency id="TqkLibrary.Proxy" version="1.0.24" />
			</group>
			<group targetFramework="net8.0-windows7.0">
				<dependency id="TqkLibrary.Proxy" version="1.0.24" />
			</group>
		</dependencies>
	</metadata>
	<files>
		<file src="bin\Release\**\$id$.dll" target="lib\" />
		<file src="bin\Release\**\$id$.pdb" target="lib\" />
		<file src="bin\Release\**\$id$.xml" target="lib\" />
		<file src="..\..\README.md" target="docs\" />
		<file src="**\*.cs" target="src\" exclude="obj\**\*.cs;bin\**\*.cs"/>
	</files>
</package>