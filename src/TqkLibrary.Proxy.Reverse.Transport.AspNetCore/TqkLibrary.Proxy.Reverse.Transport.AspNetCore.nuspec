<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
	<!--https://docs.microsoft.com/en-us/nuget/reference/nuspec-->
	<metadata>
		<id>$id$</id>
		<version>$version$</version>
		<description>ASP.NET Core hosted WebSocket transport for embedding reverse proxy into existing web applications.</description>
		<authors>tqk2811</authors>
		<projectUrl>https://github.com/tqk2811/TqkLibrary.Proxy</projectUrl>
		<repository type="git" url="https://github.com/tqk2811/TqkLibrary.Proxy.git"/>
		<license type="expression">MIT</license>
		<readme>docs\README.md</readme>
		<dependencies>
			<group targetFramework="net6.0">
				<dependency id="TqkLibrary.Proxy.Reverse" version="1.0.24" />
				<dependency id="TqkLibrary.Proxy.Reverse.Transport.WebSocket" version="1.0.24" />
			</group>
			<group targetFramework="net8.0">
				<dependency id="TqkLibrary.Proxy.Reverse" version="1.0.24" />
				<dependency id="TqkLibrary.Proxy.Reverse.Transport.WebSocket" version="1.0.24" />
			</group>
		</dependencies>
		<frameworkAssemblies>
		</frameworkAssemblies>
		<frameworkReferences>
			<group targetFramework="net6.0">
				<frameworkReference name="Microsoft.AspNetCore.App" />
			</group>
			<group targetFramework="net8.0">
				<frameworkReference name="Microsoft.AspNetCore.App" />
			</group>
		</frameworkReferences>
	</metadata>
	<files>
		<file src="bin\Release\**\$id$.dll" target="lib\" />
		<file src="bin\Release\**\$id$.pdb" target="lib\" />
		<file src="bin\Release\**\$id$.xml" target="lib\" />
		<file src="..\..\README.md" target="docs\" />
		<file src="**\*.cs" target="src\" exclude="obj\**\*.cs;bin\**\*.cs"/>
	</files>
</package>
